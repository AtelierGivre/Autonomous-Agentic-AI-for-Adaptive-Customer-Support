# ============================================================
#  FILL THESE IN WHEN YOU HAVE TIME. Everything else is ready.
#  Pick ONE way to run the model: A) Azure OpenAI, B) OpenAI or a local OpenAI-compatible server,
#  C) a Hugging Face model running on THIS machine (no API key, no data leaves your computer).
# ============================================================

# ---- A) Azure OpenAI (recommended) ----
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Optional cheaper deployment for planner/tool/verifier (falls back to the one above)
AZURE_OPENAI_DEPLOYMENT_FAST=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- B) Plain OpenAI (alternative) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FAST=
# Local server instead of the OpenAI cloud (Ollama, vLLM, llama.cpp server, LM Studio). Leave empty for real OpenAI.
#   Ollama example:  OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=qwen2.5:7b-instruct
OPENAI_BASE_URL=

# ---- C) Local Hugging Face model, in-process (set LLM_PROVIDER=local below) ----
# First run downloads the weights from the Hugging Face Hub (several GB), then it works offline.
LOCAL_MODEL=Qwen/Qwen2.5-3B-Instruct
# Optional second, smaller model for planner/tool/verifier (falls back to LOCAL_MODEL, sharing one copy in memory)
LOCAL_MODEL_FAST=
# Pin an exact commit of the model repo for reproducible, auditable deployments (empty = latest)
LOCAL_MODEL_REVISION=
# auto | cpu | cuda | mps          and          auto | bfloat16 | float16 | float32
LOCAL_DEVICE=auto
LOCAL_DTYPE=auto
LOCAL_MAX_NEW_TOKENS=400
# Temperature of the answer-writing model. The JSON agents always decode greedily (temperature 0).
LOCAL_TEMPERATURE=0.2

# ---- Provider: auto | azure | openai | local | mock ----
# auto = use Azure/OpenAI if a key (or OPENAI_BASE_URL) is filled in.  local = Hugging Face model on this machine.  mock = offline fake LLM (no key) for testing the plumbing.
LLM_PROVIDER=auto

# ---- Retrieval ----
# auto = Hugging Face embeddings when sentence-transformers is installed, otherwise
# the deterministic hash embedder (no download). hash = force offline hash.
EMBEDDING_BACKEND=auto
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Vector index: builtin = exact in-process scan (default, no dependency)
#               faiss   = optional FAISS IndexFlatIP (pip install -r requirements-rag.txt)
#               auto    = FAISS when importable, otherwise builtin
# FAISS returns the same ranking as builtin; it is faster at 10k+ chunks and can
# persist its index. See `make bench-rag`.
VECTOR_STORE=builtin
# Chunking: builtin = paragraph packer (default, no dependency)
#           llamaindex = optional SentenceSplitter (same character budget)
#           auto       = LlamaIndex when importable, otherwise builtin
INGEST_BACKEND=builtin
# Where a FAISS index is cached. Rebuilt automatically when the docs or the
# embedding/chunk settings change.
INDEX_DIR=data/index
PERSIST_INDEX=true
# The example starts at the hash-embedding scale so the base install answers on
# first run. Hugging Face embeddings usually need ~0.45.
# Tune with:  python -m evals.run_evals   (see README section "Tuning")
MIN_RETRIEVAL_SCORE=0.1
MIN_LEXICAL_COVERAGE=0.5

# ---- Security (API) ----
# Comma-separated list. EMPTY = auth off (allowed only when ENVIRONMENT=development).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
RATE_LIMIT_PER_MIN=30          # per customer (X-Customer-Id)
RATE_LIMIT_KEY_PER_MIN=600    # per API key: ceiling on total load
CORS_ORIGINS=
ENVIRONMENT=development
CONFIRM_WRITE_ACTIONS=true
REDACT_PII=true

# ---- Identity & safety ----
# The calling backend sends X-Customer-Id; tools are scoped to it. This is the fallback when it is absent.
# Keep "demo" for the class demo. In PRODUCTION leave it EMPTY (the Docker image already does).
DEFAULT_CUSTOMER_ID=demo
# Seconds a "reply YES to confirm" stays valid
CONFIRM_TTL_S=600
# Provider-enforced JSON output for planner/tool/verifier (recommended)
JSON_MODE=true
# Exclude knowledge-base documents that look like prompt injection
KB_SKIP_SUSPICIOUS=true

# ---- Limits ----
MAX_LLM_CALLS_PER_REQUEST=10
MAX_COST_PER_REQUEST_USD=0.05
REQUEST_TIMEOUT_S=60
LLM_TIMEOUT_S=30

# ---- Data ----
RETENTION_DAYS=30
LOG_LEVEL=INFO
LOG_JSON=false
DEBUG_RESPONSES=true

# ---- Cost model (USD per 1K tokens; edit to your model's real price) ----
PRICE_INPUT_PER_1K=0.00015
PRICE_OUTPUT_PER_1K=0.0006
