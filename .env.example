# ============================================================
#  FILL THESE IN WHEN YOU HAVE TIME. Everything else is ready.
#  Use EITHER Azure OpenAI (section A) OR OpenAI (section B).
# ============================================================

# ---- A) Azure OpenAI (recommended, matches the Azure deployment) ----
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- B) Plain OpenAI (alternative) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Provider: auto | azure | openai | mock ----
# auto  = use whichever key is filled in above
# mock  = offline fake LLM (no key needed) to test the plumbing
LLM_PROVIDER=auto

# ---- Retrieval embeddings: hf (real, downloads a small model once) | hash (offline test) ----
EMBEDDING_BACKEND=hf
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Cost tracking (USD per 1K tokens; edit to match your model's price) ----
PRICE_INPUT_PER_1K=0.00015
PRICE_OUTPUT_PER_1K=0.0006
